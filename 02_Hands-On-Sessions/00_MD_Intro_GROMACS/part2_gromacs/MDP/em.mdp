; Energy minimisation for methane (UA) slab
integrator  = steep
emtol       = 100.0
nsteps      = 2000
nstenergy   = 50
nstlog      = 50

cutoff-scheme = Verlet
nstlist       = 10
pbc           = xyz
rlist         = 1.2
coulombtype   = Cut-off
rcoulomb      = 1.2
vdwtype       = Cut-off
rvdw          = 1.2
DispCorr      = EnerPres
