; Short NVT equilibration — TEMPLATE (methane UA)
; Students: copy to nvt_TXXX.mdp and set ref_t / gen_temp (kelvin)
; Methane TraPPE-like: ε/kB ≈ 148 K; experimental Tc ≈ 190 K — stay below Tc

integrator  = md
dt          = 0.002
nsteps      = 100000         ; 200 ps equilibration (dt=0.002)

nstxout-compressed = 500
nstenergy          = 200
nstlog             = 200

cutoff-scheme = Verlet
nstlist       = 10
pbc           = xyz
rlist         = 1.2
coulombtype   = Cut-off
rcoulomb      = 1.2
vdwtype       = Cut-off
rvdw          = 1.2
DispCorr      = EnerPres

tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.2
ref_t       = 140            ; T = 140 K

pcoupl      = no

gen_vel     = yes
gen_temp    = 140
gen_seed    = -1
continuation = no
constraints  = none
