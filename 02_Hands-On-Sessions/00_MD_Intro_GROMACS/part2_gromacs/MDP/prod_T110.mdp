; Production NVT for methane coexistence — TEMPLATE
; Copy to prod_TXXX.mdp and set ref_t (kelvin).
; Do NOT use a barostat: the elongated slab needs fixed box volume
; so liquid and vapour can coexist at the orthobaric densities.

integrator  = md
dt          = 0.002
nsteps      = 1000000        ; 2.0 ns (dt=0.002)

nstxout-compressed = 1000
nstenergy          = 500
nstlog             = 500

cutoff-scheme = Verlet
nstlist       = 10
pbc           = xyz
rlist         = 1.2
coulombtype   = Cut-off
rcoulomb      = 1.2
vdwtype       = Cut-off
rvdw          = 1.2
DispCorr      = EnerPres

tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.2
ref_t       = 110            ; T = 110 K

pcoupl      = no

gen_vel      = no
continuation = yes
constraints  = none
