;RUN CONTROL PARAMETERS
integrator               = steep
dt                       = 0.001
nsteps                   = 100000
comm-mode                = Linear
comm-grps                = MMT1 MMT2 Na H2 SOL
nstcomm                  = 100
emtol                    = 1.0
emstep                   = 0.001
nstxout                  = 10
nstvout                  = 10
nstfout                  = 10
cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
rlist                    = 1.0
coulombtype              = PME
vdw-type                 = Cut-off
rcoulomb                 = 1.0
rvdw                     = 1.0
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-05
constraints              = none
constraint_algorithm     = lincs
lincs_order              = 4
lincs_iter               = 1
DispCorr                 = No
pbc                      = xyz
periodic-molecules       = yes
refcoord-scaling         = No
